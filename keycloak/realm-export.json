{
  "realm": "ecommerce",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "customer",
        "description": "Default role for any registered user"
      },
      {
        "name": "seller",
        "description": "User has an active SellerAccount in UserService"
      },
      { "name": "admin", "description": "Platform administrator" }
    ]
  },

  "clients": [
    {
      "clientId": "ecommerce-frontend",
      "name": "E-Commerce Frontend",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:3000/*",
        "https://oauth.pstmn.io/v1/callback"
      ],
      "webOrigins": ["http://localhost:5173", "http://localhost:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*##http://localhost:3000/*"
      },
      "defaultClientScopes": [
        "basic",
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email"
      ],
      "optionalClientScopes": ["address", "phone", "offline_access"],
      "protocolMappers": [
        {
          "name": "audience-ecommerce-frontend",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "ecommerce-frontend",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],

  "users": [
    {
      "username": "customer1",
      "email": "customer1@example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Test",
      "lastName": "Customer",
      "credentials": [
        { "type": "password", "value": "Passw0rd!", "temporary": false }
      ],
      "realmRoles": ["default-roles-ecommerce", "customer"]
    },
    {
      "username": "seller1",
      "email": "seller1@example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Test",
      "lastName": "Seller",
      "credentials": [
        { "type": "password", "value": "Passw0rd!", "temporary": false }
      ],
      "realmRoles": ["default-roles-ecommerce", "customer", "seller"]
    }
  ]
}
